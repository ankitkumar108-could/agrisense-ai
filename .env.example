# Copy this file to .env and fill in your own values

# Any random long random string (used to secure login sessions)
SECRET_KEY=change_this_to_something_random_and_long

# Your city name for weather lookups (e.g. "Lucknow", "Delhi")
# Weather itself is free forever — no key, no signup needed (uses Open-Meteo).
WEATHER_CITY=Lucknow

# Simple shared secret so only your ESP32 can post sensor data
DEVICE_API_KEY=change_this_to_your_own_device_secret

# Moisture threshold (raw ESP32 analogRead value, 0-4095). Above this = dry.
MOISTURE_THRESHOLD=2500

# If rain probability (%) from weather API is above this, skip watering even if soil is dry
RAIN_SKIP_PROBABILITY=50

# Free key for the AI chat feature — get one free at https://ai.google.dev (Google Gemini)
# Leave blank and the "Get Recommendation" button still works (rule-based); only free-text
# AI chat needs this key.
GEMINI_API_KEY=
